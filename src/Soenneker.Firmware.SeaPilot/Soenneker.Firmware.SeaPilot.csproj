<?xml version="1.0" encoding="utf-8"?>

<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <IsAotCompatible>true</IsAotCompatible>
        <Nullable>enable</Nullable>
        <Platforms>AnyCPU</Platforms>
        <NoWarn>$(NoWarn);1591</NoWarn>
    </PropertyGroup>

    <PropertyGroup>
        <Description>Seagate firmware discovery and downloads using OpenSeaChest and stealth browser automation.</Description>
        <Version Condition="'$(BUILD_VERSION)' == ''">4.0.0</Version>
        <Version Condition="'$(BUILD_VERSION)' != ''">$(BUILD_VERSION)</Version>
        <AssemblyName>Soenneker.Firmware.SeaPilot</AssemblyName>
        <PackageId>Soenneker.Firmware.SeaPilot</PackageId>
        <PackageTags>firmware seapilot seagate openseachest playwright util csharp dotnet c# .net</PackageTags>
        <Copyright>Copyright © 2026 Jake Soenneker</Copyright>
        <Authors>Jake Soenneker</Authors>
        <Company>https://soenneker.com</Company>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <IsPackable>true</IsPackable>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/soenneker/soenneker.firmware.seapilot</PackageProjectUrl>
        <RepositoryUrl>https://github.com/soenneker/soenneker.firmware.seapilot</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <RepositoryBranch>main</RepositoryBranch>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <LangVersion>latest</LangVersion>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>icon.png</PackageIcon>
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
        <PackageReleaseNotes Condition="'$(PACKAGE_RELEASE_NOTES)' != ''">$(PACKAGE_RELEASE_NOTES)</PackageReleaseNotes>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" PackagePath="\" />
        <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
        <None Include="..\..\icon.png" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Soenneker.Asyncs.Semaphores" Version="4.0.33" />
        <PackageReference Include="Soenneker.Compression.Zip" Version="4.0.54" />
        <PackageReference Include="Soenneker.OpenSeaChest.Util" Version="4.0.6" PrivateAssets="none" />
        <PackageReference Include="Soenneker.Playwrights.Extensions.Stealth" Version="4.0.182" />
        <PackageReference Include="Soenneker.Playwrights.Installation" Version="4.0.228" />
        <PackageReference Include="Soenneker.Utils.Directory" Version="4.0.967" />
        <PackageReference Include="Soenneker.Utils.File" Version="4.0.2319" />
        <PackageReference Include="Soenneker.Utils.Json" Version="4.0.2757" />
    </ItemGroup>
</Project>

