<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>seapilot</AssemblyName>
    <IsPackable>false</IsPackable>
    <PublishTrimmed>false</PublishTrimmed>
    <Version Condition="'$(BUILD_VERSION)' == ''">4.0.0</Version>
    <Version Condition="'$(BUILD_VERSION)' != ''">$(BUILD_VERSION)</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Soenneker.OpenSeaChest.Binaries" Version="4.0.3" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.13" />
    <ProjectReference Include="../Soenneker.Firmware.SeaPilot/Soenneker.Firmware.SeaPilot.csproj" />
  </ItemGroup>
</Project>
